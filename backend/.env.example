# Copy to .env and adjust as needed. All values are optional; defaults shown.

# Paths (relative paths resolve from the process cwd)
# ARTIFACTS_DIR defaults to <backend>/artifacts
# ARTIFACTS_DIR=artifacts
# MODEL_PATH defaults to <ARTIFACTS_DIR>/model.onnx
# MODEL_PATH=artifacts/model.onnx
# MODEL_META_PATH defaults to <ARTIFACTS_DIR>/model.meta.json
# MODEL_META_PATH=artifacts/model.meta.json
# INDEX_PATH defaults to <ARTIFACTS_DIR>/index.faiss
# INDEX_PATH=artifacts/index.faiss
# INDEX_META_PATH defaults to <ARTIFACTS_DIR>/index_meta.json
# INDEX_META_PATH=artifacts/index_meta.json

# Upload limits
MAX_FILES=10
MAX_BYTES=8388608
MAX_DIM=8000

# Search
TOP_K=5

# Demo (keyless sliding window)
DEMO_WINDOW_S=3600
DEMO_LIMIT_PER_TIME=100

# Image embedding batch size
BATCH_SIZE=16
